# =============================================================================
# SafeBand Guardian v4.0.0 - Environment Configuration Template
# Copy this file to .env and configure for your deployment environment.
# NEVER commit .env with real secrets to public version control!
# =============================================================================

# --- Backend Server Configuration ---
PORT=8080
# SPRING_PROFILES_ACTIVE options:
#   standalone : Embedded H2 database in PostgreSQL mode (zero-dependency, persistent file storage)
#   postgres   : External production PostgreSQL database
SPRING_PROFILES_ACTIVE=standalone

# --- PostgreSQL Configuration (used when SPRING_PROFILES_ACTIVE=postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safeband
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here

# --- Authentication & Cryptography ---
# Must be at least 32 characters long for HMAC-SHA256
JWT_SECRET=SafeBandGuardianMasterSecretKeyForHmacSha256MustBeAtLeast32BytesLong
JWT_ACCESS_EXPIRY=3600000
JWT_REFRESH_EXPIRY=2592000000

# --- Google Identity & OAuth 2.0 ---
# Google Cloud Console Web Application Client ID
GOOGLE_CLIENT_ID=104192847120-safeband-guardian.apps.googleusercontent.com

# --- Firebase Cloud Messaging (FCM) ---
FIREBASE_ENABLED=false
# Path to service account private key JSON file (backend only, NEVER package in APK!)
FIREBASE_CONFIG_PATH=""

# --- Secure Public Tunnel ---
# Automatically populated by start-backend.bat or configure your custom Cloudflare Tunnel domain
PUBLIC_TUNNEL_URL=http://localhost:8080
