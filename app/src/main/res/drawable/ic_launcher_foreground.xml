        android:pathData="M 44,40 C 44,34 64,34 64,40 C 64,48 54,52 54,52 C 54,52 44,48 44,40 Z"
        android:fillColor="#00BBF9" />

    <!-- Protected Child Node: Core radiant beacon of the child -->
