        android:pathData="M 54, 43 m -4, 0 a 4,4 0 1,0 8,0 a 4,4 0 1,0 -8,0"
        android:fillColor="#00F5D4" />

    <!-- SafeBand Smartband Telemetry Pulse (Safety Signal) -->
