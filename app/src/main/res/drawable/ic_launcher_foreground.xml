        android:strokeLineJoin="round" />

    <!-- High-Trust Golden Sentinel Sparkle -->
    <path
        android:pathData="M 54, 33 m -2.2, 0 a 2.2,2.2 0 1,0 4.4,0 a 2.2,2.2 0 1,0 -4.4,0"
        android:fillColor="#FFD166" />
