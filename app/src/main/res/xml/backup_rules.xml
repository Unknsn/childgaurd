<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive Room database records (children bio, guardian identities, auth tokens) -->
    <exclude domain="database" path="safeband_database" />
    <exclude domain="database" path="safeband_database-wal" />
    <exclude domain="database" path="safeband_database-shm" />
    <!-- Exclude sensitive DataStore preferences -->
    <exclude domain="sharedpref" path="safeband_preferences" />
    <exclude domain="root" path="files/datastore/safeband_preferences.preferences_pb" />
    <exclude domain="root" path="databases" />
</full-backup-content>
